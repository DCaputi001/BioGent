# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.
#
# Nothing here is a secret -- these are ARNs, hostnames and bucket names, all
# visible in the AWS console. The database password stays in Secrets Manager
# and the researcher's Anthropic key never leaves their browser.

aws_region  = "us-east-1"
aws_profile = "biogent-admin"

# From services/rag/.env -- the same values the app already uses locally.
db_secret_arn    = "arn:aws:secretsmanager:us-east-1:396913715360:secret:rds!db-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx-xxxxxx"
db_host          = "biogent-rag-dev.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com"
db_name          = "biogent_rag"
documents_bucket = "biogent-rag-dev-dcaputi"

# The security group attached to the RDS instance. Find it with:
#   aws rds describe-db-instances --db-instance-identifier biogent-rag-dev \
#     --query "DBInstances[0].VpcSecurityGroups[*].VpcSecurityGroupId" \
#     --output text --profile biogent-admin
rds_security_group_id = "sg-xxxxxxxxxxxxxxxxx"

# Set to 0 between working sessions to stop paying for Fargate. The load
# balancer bills whether or not a task is running.
desired_count = 1

# Optional -- LangSmith tracing. Leave it unset to deploy with tracing off;
# every LangSmith resource is conditional on this value, so an unset variable
# produces no plan changes at all. Create the secret first, then paste the ARN
# it returns (the random suffix is not derivable from the name):
#   aws secretsmanager create-secret --name biogent/langsmith-api-key \
#     --secret-string "lsv2_..." --profile biogent-admin
#
# Setting this registers a new task definition revision, but the running
# service only picks it up on the next deploy workflow run -- see infra/README.md.
# langsmith_secret_arn = "arn:aws:secretsmanager:us-east-1:396913715360:secret:biogent/langsmith-api-key-xxxxxx"

# Optional -- a custom domain for the CloudFront distribution, on top of the
# *.cloudfront.net URL it always has. Requires a validated ACM certificate in
# us-east-1 (CloudFront reads certificates from nowhere else), and if the
# domain's DNS is a Route 53 zone in this account, see infra/route53.tf --
# its alias records need `terraform import` once, documented in infra/README.md.
# custom_domain_names = ["example.org", "www.example.org"]
# acm_certificate_arn = "arn:aws:acm:us-east-1:396913715360:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
