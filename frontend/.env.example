# Copy to .env.local and adjust. .env.local is git-ignored.
#
# Base URL of the RAG service's HTTP API (services/rag/app/api.py), including
# the /api prefix every route is served under.
# Local backend: uv run uvicorn app.api:app --reload --port 8000
# Deployed: just "/api" — CloudFront serves the app and the API from one domain,
# so the call is same-origin and no absolute URL (or CORS) is needed.
#
# NOTE: only variables prefixed with VITE_ are exposed to the browser, and every
# one of them is embedded in the built JavaScript in plain text. Never put a
# secret here. The researcher's Anthropic key is typed into the UI at runtime
# and kept in the browser session; it is never a build-time value.
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Amazon Cognito sign-in (Phase 8). All three come from Terraform outputs:
#   cd infra
#   terraform output cognito_authority
#   terraform output cognito_client_id
#   terraform output cognito_hosted_ui_domain
#
# Identifiers, not secrets: the SPA client is a public client with no secret,
# which is what makes authorization-code-with-PKCE the right flow for it.
# Without these set, the app renders a "sign-in is not configured" notice
# instead of redirecting into an opaque Cognito error page.
#
# http://localhost:5173 is an allowed redirect target by default
# (cognito_local_dev_urls in infra/variables.tf), so local sign-in works
# against the real pool.
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_HOSTED_UI_DOMAIN=https://biogent-000000000000.auth.us-east-1.amazoncognito.com
