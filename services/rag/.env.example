# Copy to .env and fill in. .env is git-ignored; never commit real credentials.

# Your own Anthropic key, for the CLI (python -m app.query) and the evals only.
# The HTTP API ignores this entirely: web requests must carry the researcher's own
# key in an X-Anthropic-Api-Key header (BYO-key, never persisted server-side).
ANTHROPIC_API_KEY=

# Origins allowed to call the HTTP API from a browser. Comma-separated.
# Defaults to Vite's dev server; add your CloudFront domain when deploying.
# RAG_CORS_ORIGINS=http://localhost:5173

# --- Vector store: LOCAL Postgres only ---
# Used only when RAG_DB_SECRET_ID (below) is unset. Defaults to the local
# docker-compose Postgres if unset. Never point this at RDS: that puts a real
# password in this file. Use the Secrets Manager settings below instead.
# NOTE: docker-compose.yml's rag service sets this itself and that override wins,
# so this value applies to host runs (uv run ...), not `docker compose run rag`.
RAG_DATABASE_URL=postgresql+psycopg://biogent:biogent@localhost:5432/biogent_rag

# --- Vector store: RDS, via AWS Secrets Manager ---
# Setting RAG_DB_SECRET_ID switches to RDS. The username/password are fetched
# from this secret at runtime and never stored here. An RDS-managed master
# secret only holds username/password, so host and database name go below
# (they are not secret). A secret that includes host/port/dbname overrides them.
# RAG_DB_SECRET_ID=arn:aws:secretsmanager:us-east-1:123456789012:secret:rds!db-example
# RAG_DB_HOST=your-instance.xxxxxxxx.us-east-1.rds.amazonaws.com
# RAG_DB_PORT=5432
# RAG_DB_NAME=biogent_rag
# RAG_DB_SSLMODE=require

# Run OCR over PDFs. Off by default: born-digital PDFs already have a text layer,
# so OCR finds nothing and costs roughly 90 seconds per ingestion run. Set true
# only for scanned or image-only documents. See KNOWN_ISSUES.md.
RAG_DO_OCR=false

# --- AWS access (shared by S3 and Secrets Manager) ---
# Locally, use a named AWS CLI profile (`aws configure --profile biogent`); on AWS,
# use an IAM role and leave AWS_PROFILE unset. One profile covers every AWS service
# this app calls.
# Do NOT also set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here: boto3 checks those
# before AWS_PROFILE, so leftover keys silently override the profile.
# AWS_PROFILE=biogent
# Either AWS_REGION or AWS_DEFAULT_REGION works; AWS_REGION wins if both are set.
# AWS_REGION=us-east-1

# AWS S3 document source, only used by `python -m app.ingest --from-s3`.
# RAG_S3_BUCKET=your-bucket-name-here
# Optional: only ingest keys under this prefix, e.g. papers/
# RAG_S3_PREFIX=

# --- LangSmith tracing (Phase 6) ---
# Optional locally; PRODUCTION_PLAN.md Phase 0 assumes an account exists.
# Get a key at smith.langchain.com -> Settings -> API Keys.
#
# These are read directly by LangChain's SDK, not by this app's own code, so
# setting them is enough -- no code change makes tracing take effect. config.py
# still documents them, so this stays the one place to see every env var the
# service responds to.
#
# LANGCHAIN_* names still work (LangChain's older name for these) but
# LANGSMITH_* is current; use that for anything new.
#
# A project name distinct from production keeps local experiments out of the
# dashboard you'd watch for real traffic. evals/run_evals.py appends "-evals"
# to whatever you set here, so eval runs get their own project too.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=biogent-rag-dev

# --- Authentication: Amazon Cognito (Phase 8) ---
# Required for POST /api/ask: it identifies WHO is asking, which decides whose
# documents get searched. The Anthropic key is a separate credential answering
# a separate question (who pays), and neither substitutes for the other.
#
# Both values come from Terraform, and neither is a secret -- the web client is
# a public SPA client with no secret at all:
#   cd infra && terraform output cognito_user_pool_id
#   cd infra && terraform output cognito_client_id
#
# Unset, the API starts fine and /api/health still answers, but /api/ask fails
# with a configuration error in the log rather than pretending the caller is
# unauthorized.
# RAG_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
# RAG_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Evaluation corpus owner (Phase 8) ---
# Retrieval is filtered by owner, and an eval run never signs in, so the eval
# corpus is owned by this fixed sentinel rather than by any real account.
# Seed it with:
#   uv run python -m app.ingest --reset --user-id eval-fixture
# Change it only if you also re-seed: the old corpus becomes unreachable.
# RAG_EVAL_USER_ID=eval-fixture
