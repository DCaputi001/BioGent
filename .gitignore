# --- Python (services/rag, services/data-agent) ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log

# --- Environment / secrets ---
.env
.env.*
!.env.example
# Build-time configuration, no secrets: the production API base URL. Tracked so
# a production build does not depend on the shell it runs in.
!.env.production

# --- Node / React (frontend) ---
node_modules/
frontend/dist/
frontend/build/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Docker ---
*.pid

# --- Local data / generated stores (never commit real research data) ---
chroma_db/
*.sqlite3
data/
uploads/

# --- OS clutter ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editor / IDE ---
.vscode/
.idea/
*.swp

#data folder
data/

# NOTE: ARCHITECTURE.md and PRODUCTION_PLAN.md are deliberately TRACKED, not
# ignored. AGENTS.md and KNOWN_ISSUES.md both point at them as the source of
# truth for design decisions and build order, so they have to exist in a fresh
# clone for those references to mean anything.
# --- Terraform (infra/) ---
# State can contain resource attributes and generated secrets; tfvars holds
# account-specific values. Both stay out of git — state lives in S3.
**/.terraform/
*.tfstate
*.tfstate.*
# Saved plans, whatever they are called. A plan file is a build artifact, and a
# plan generated once resources exist embeds their attributes IN PLAINTEXT --
# including random_password values such as the ALB origin secret. "*.tfplan"
# alone missed the conventional extensionless name.
tfplan
tfplan.*
*.tfplan
terraform.tfvars
*.auto.tfvars
!terraform.tfvars.example
